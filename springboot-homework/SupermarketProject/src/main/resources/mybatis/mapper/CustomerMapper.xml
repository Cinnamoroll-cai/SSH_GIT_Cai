<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.seiryo.admin.mapper.CustomerMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.edu.seiryo.admin.pojo.Customer">
        <id column="id" property="id" />
        <result column="address" property="address" />
        <result column="contact" property="contact" />
        <result column="name" property="name" />
        <result column="number" property="number" />
        <result column="remarks" property="remarks" />
        <result column="is_del" property="isDel" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
    	id, address, contact, name, "NUMBER", remarks, is_del
	</sql>
	
	<select id="queryAllValidCustomer" resultMap="BaseResultMap">
	    SELECT
	        id, 
	        "NUMBER",  <!-- 改成大写 -->
	        address, 
	        contact, 
	        name, 
	        is_del, 
	        remarks
	    FROM t_customer
	    WHERE is_del = 0
	</select>
</mapper>
