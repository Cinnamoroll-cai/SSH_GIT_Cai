<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.seiryo.admin.mapper.PurchaseListMapper">
	<!--
                 查询今天已生成的最大进货单号
        Oracle 写法：TRUNC(purchase_date) = TRUNC(SYSDATE)
                 前端页面加载后，后端会调用此方法生成单号，并返回到前端显示
    -->
    <select id="getMaxPurchaseNumberToday" resultType="string">
        SELECT MAX(purchase_number)
        FROM t_purchase_list
        WHERE TRUNC(purchase_date) = TRUNC(SYSDATE)
          AND purchase_number LIKE CONCAT(#{today}, '%')
    </select>
</mapper>
